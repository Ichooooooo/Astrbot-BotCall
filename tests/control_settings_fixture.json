     "fields": [
      {
       "key": "review_style",
       "label": "回顾写法",
       "help": "通话结束后发回原聊天的回顾怎么写。",
       "type": "choice",
       "value": "default",
       "default": "default",
       "applies": "next_call",
       "choices": [
        {
         "value": "default",
         "label": "标准回顾",
         "description": "先概述，再按话题分段，和以前一样。",
         "example": "本次通话聊了你最近的工作安排……"
        },
        {
         "value": "bullets",
         "label": "要点＋待办",
         "description": "先列要点，再单列待办。",
         "example": "要点：\n· 下周三前交方案\n待办：\n· 约客户确认时间"
        },
        {
         "value": "spoken",
         "label": "口语小结",
         "description": "像朋友一样几句话说清楚。",
         "example": "刚才咱们主要聊了下周的安排，你打算先把方案赶出来。"
        },
        {
         "value": "sections",
         "label": "分节详细",
         "description": "分成背景、讨论、结论几节，信息最全。",
         "example": "一、背景\n二、讨论\n三、结论"
